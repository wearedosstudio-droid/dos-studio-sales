# Copia este archivo como .env.local y rellena los valores. No subas nunca .env.local al repositorio.
# En Vercel: Project → Settings → Environment Variables (las mismas claves).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el cron diario de avisos (se salta RLS). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del panel, para los enlaces de los emails
APP_URL=https://app.dosstudiomkt.com

# Emails con Resend (resend.com): clave de API y remitente de un dominio verificado
RESEND_API_KEY=
EMAIL_FROM="Dos Studio OS <avisos@dosstudiomkt.com>"

# Secreto del cron: Vercel lo envía en la cabecera Authorization. Genera uno largo y aleatorio.
CRON_SECRET=
